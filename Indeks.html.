        // Harga Tambahan Stick per Konsol
        const EXTRA_STICK_PRICE = {
            ps3: 5000,
            ps4: 10000,
            ps5: 20000
        };

        // Format Angka ke Rupiah
        function formatRupiah(amount) {
            return "Rp " + amount.toLocaleString("id-ID");
        }

        // Render Kartu Daftar Harga Berdasarkan Tab Aktif
        function switchPriceTab(serviceKey) {
            // Update tampilan tombol tab
            document.querySelectorAll('.price-tab').forEach(btn => {
                btn.classList.remove('bg-psBlue', 'text-white', 'shadow-lg', 'shadow-blue-600/30');
                btn.classList.add('bg-cardBg', 'text-slate-300', 'border', 'border-slate-700');
            });

            const activeBtn = document.getElementById(`tab-${serviceKey}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-cardBg', 'text-slate-300', 'border', 'border-slate-700');
                activeBtn.classList.add('bg-psBlue', 'text-white', 'shadow-lg', 'shadow-blue-600/30');
            }

            // Update banner penjelasan
            const data = PRICING_DATA[serviceKey];
            document.getElementById('tab-info-text').innerHTML = data.info;

            // Render 3 Kartu PS (PS3, PS4, PS5)
            const container = document.getElementById('pricing-cards-container');
            container.innerHTML = '';

            const consoleKeys = ['ps3', 'ps4', 'ps5'];
            consoleKeys.forEach(cKey => {
                const item = data.consoles[cKey];
                const isHighlight = cKey === 'ps4';
                
                const badgeColors = {
                    blue: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
                    purple: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
                    amber: 'bg-amber-500/20 text-amber-300 border-amber-500/30'
                };

                const ratesHtml = item.rates.map(r => `
                    <div class="flex items-center justify-between py-2.5 border-b border-slate-800/80 last:border-b-0">
                        <span class="text-slate-300 text-sm">${r.label}</span>
                        <span class="font-gaming font-bold text-white text-sm sm:text-base">${formatRupiah(r.price)}</span>
                    </div>
                `).join('');

                const cardHtml = `
                    <div class="relative bg-cardBg rounded-3xl p-6 sm:p-8 border ${isHighlight ? 'border-neonPurple shadow-2xl glow-purple' : 'border-slate-800'} flex flex-col justify-between transition-transform hover:-translate-y-1">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <span class="px-3 py-1 rounded-full text-xs font-bold border ${badgeColors[item.accent]}">
                                    ${item.badge}
                                </span>
                                <i class="fa-brands fa-playstation text-2xl text-slate-500"></i>
                            </div>

                            <h3 class="font-gaming text-2xl font-extrabold text-white mb-1">${item.name}</h3>
                            <p class="text-xs sm:text-sm text-slate-400 mb-6">${item.subtitle}</p>

                            <div class="bg-darkBg/80 rounded-2xl p-4 border border-slate-800/90 mb-6">
                                ${ratesHtml}
                            </div>

                            <div class="mb-6">
                                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Game Populer Tersedia:</p>
                                <p class="text-xs text-slate-300 leading-relaxed">${item.popularGames}</p>
                            </div>
                        </div>

                        <button type="button" onclick="selectPackageToOrder('${cKey}', '${serviceKey}')" 
                            class="w-full py-3.5 px-5 rounded-xl font-bold text-sm transition-all flex items-center justify-center gap-2 ${isHighlight ? 'bg-gradient-to-r from-psBlue to-neonPurple text-white shadow-lg' : 'bg-slate-800 hover:bg-psBlue text-white'}">
                            <span>Pilih Paket ${item.name}</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                `;
                container.innerHTML += cardHtml;
            });
        }

        // Shortcut dari Kartu Harga langsung mengisi Form Pemesanan
        function selectPackageToOrder(consoleKey, serviceKey) {
            document.getElementById('console-type').value = consoleKey;
            document.getElementById('service-type').value = serviceKey;
            updateDurationOptions();
            calculateTotal();
            
            const orderSection = document.getElementById('order');
            orderSection.scrollIntoView({ behavior: 'smooth' });
            showToast(`Paket ${consoleKey.toUpperCase()} dipilih! Silakan lengkapi form di bawah.`, 'info');
        }

        // Update Pilihan Durasi pada Form Berdasarkan Bentuk Pemesanan & Tipe PS
        function updateDurationOptions() {
            const consoleKey = document.getElementById('console-type').value;
            const serviceKey = document.getElementById('service-type').value;
            const durationSelect = document.getElementById('duration-type');
            const previousValue = durationSelect.value;

            const rates = PRICING_DATA[serviceKey].consoles[consoleKey].rates;
            durationSelect.innerHTML = '';

            rates.forEach(rate => {
                const option = document.createElement('option');
                option.value = rate.id;
                option.textContent = `${rate.label} — ${formatRupiah(rate.price)}`;
                durationSelect.appendChild(option);
            });

            // Pertahankan pilihan durasi sebelumnya jika tersedia di opsi baru
            if (rates.some(r => r.id === previousValue)) {
                durationSelect.value = previousValue;
            } else if (rates.some(r => r.id === '24h')) {
                durationSelect.value = '24h';
            }

            // Tampilkan/Sembunyikan input alamat & ongkir jika pilih Diantar Sampai Rumah
            const deliveryBox = document.getElementById('delivery-options-box');
            const deliverySummaryRow = document.getElementById('summary-delivery-row');
            if (serviceKey === 'delivery') {
                deliveryBox.classList.remove('hidden');
                deliverySummaryRow.classList.remove('hidden');
            } else {
                deliveryBox.classList.add('hidden');
                deliverySummaryRow.classList.add('hidden');
            }
        }

        // Kalkulator Estimasi Biaya Real-Time
        function calculateTotal() {
            const consoleKey = document.getElementById('console-type').value;
            const serviceKey = document.getElementById('service-type').value;
            const durationId = document.getElementById('duration-type').value;
            const extraStickCount = parseInt(document.getElementById('extra-stick').value, 10) || 0;
            const deliveryFee = serviceKey === 'delivery' ? (parseInt(document.getElementById('delivery-zone').value, 10) || 0) : 0;
            const paymentMethod = document.getElementById('payment-method').value;

            const consoleData = PRICING_DATA[serviceKey].consoles[consoleKey];
            const selectedRate = consoleData.rates.find(r => r.id === durationId) || consoleData.rates[0];

            const basePrice = selectedRate.price;
            const stickTotalPrice = extraStickCount * EXTRA_STICK_PRICE[consoleKey];
            const grandTotal = basePrice + stickTotalPrice + deliveryFee;

            // Label Layanan
            const serviceLabels = {
                onsite: "Main di Tempat Rental",
                cod: "Ambil Sendiri / COD",
                delivery: "Diantar Sampai Rumah"
            };

            // Update Ringkasan UI
            document.getElementById('summary-console').textContent = consoleData.name;
            document.getElementById('summary-service').textContent = serviceLabels[serviceKey];
            document.getElementById('summary-duration').textContent = selectedRate.label;
            document.getElementById('summary-base-price').textContent = formatRupiah(basePrice);
            document.getElementById('summary-stick-price').textContent = extraStickCount > 0 
                ? `+${extraStickCount} Stick (${formatRupiah(stickTotalPrice)})` 
                : "Rp 0";
            
            if (serviceKey === 'delivery') {
                document.getElementById('summary-delivery-price').textContent = deliveryFee === 0 
                    ? "GRATIS (Rp 0)" 
                    : formatRupiah(deliveryFee);
            }

            document.getElementById('summary-payment').textContent = paymentMethod;
            document.getElementById('summary-total').textContent = formatRupiah(grandTotal);

            return {
                consoleName: consoleData.name,
                serviceLabel: serviceLabels[serviceKey],
                serviceKey,
                durationLabel: selectedRate.label,
                basePrice,
                extraStickCount,
                stickTotalPrice,
                deliveryFee,
                paymentMethod,
                grandTotal
            };
        }

        // Kirim Pesanan ke WhatsApp Rizz Store (085724140876)
        function sendWhatsAppOrder() {
            const nameInput = document.getElementById('customer-name');
            const customerName = nameInput.value.trim();

            if (!customerName) {
                nameInput.focus();
                showToast('Mohon isi Nama Pemesan terlebih dahulu!', 'error');
                return;
            }

            const calc = calculateTotal();
            const addressInput = document.getElementById('customer-address');
            const customerAddress = addressInput.value.trim();

            if (calc.serviceKey === 'delivery' && !customerAddress) {
                addressInput.focus();
                showToast('Mohon isi Alamat Lengkap untuk pengantaran ke rumah!', 'error');
                return;
            }

            const startTime = document.getElementById('start-time').value.trim() || "Secepatnya / Konfirmasi Admin";
            const gameRequest = document.getElementById('game-request').value.trim() || "-";

            // Susun Format Pesan WhatsApp yang Rapi
            let message = `Halo Admin *Rizz Store*, saya mau booking sewa PlayStation:\n\n`;
            message += `*DATA PEMESAN*\n`;
            message += `• Nama: *${customerName}*\n`;
            message += `• Jadwal Mulai: ${startTime}\n\n`;
            message += `*DETAIL SEWA*\n`;
            message += `• Tipe Konsol: *${calc.consoleName}*\n`;
            message += `• Layanan: *${calc.serviceLabel}*\n`;
            message += `• Durasi Paket: *${calc.durationLabel}* (${formatRupiah(calc.basePrice)})\n`;
            message += `• Tambahan Stick: ${calc.extraStickCount > 0 ? `+${calc.extraStickCount} Stick (${formatRupiah(calc.stickTotalPrice)})` : 'Tidak ada (Standar 2 Stick)'}\n`;
            
            if (calc.serviceKey === 'delivery') {
                const zoneSelect = document.getElementById('delivery-zone');
                const zoneText = zoneSelect.options[zoneSelect.selectedIndex].text;
                message += `• Jarak Antar: ${zoneText}\n`;
                message += `• Alamat Antar: *${customerAddress}*\n`;
            }

            message += `• Request Game: ${gameRequest}\n\n`;
            message += `*PEMBAYARAN*\n`;
            message += `• Metode: *${calc.paymentMethod}*\n`;
            message += `• Total Estimasi: *${formatRupiah(calc.grandTotal)}*\n\n`;
            message += `Mohon info ketersediaan unitnya ya Min. Terima kasih!`;

            const encodedMessage = encodeURIComponent(message);
            const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodedMessage}`;

            showToast('Mengarahkan ke WhatsApp Rizz Store...', 'success');
            window.open(waUrl, '_blank', 'noopener');
        }

        // Fitur Salin Nomor Rekening / E-Wallet
        function copyAccount(textToCopy, label) {
            const tempInput = document.createElement('input');
            tempInput.value = textToCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showToast(`${label} (${textToCopy}) berhasil disalin!`, 'success');
        }

        // Custom Toast Notification (Pengganti alert)
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const styles = {
                success: 'bg-emerald-600 border-emerald-400 text-white',
                error: 'bg-rose-600 border-rose-400 text-white',
                info: 'bg-psBlue border-blue-400 text-white'
            };

            const icons = {
                success: 'fa-circle-check',
                error: 'fa-circle-exclamation',
                info: 'fa-circle-info'
            };

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-2xl border shadow-2xl text-sm font-semibold transition-all duration-300 transform translate-y-0 ${styles[type]}`;
            toast.innerHTML = `
                <i class="fa-solid ${icons[type]} text-base"></i>
                <span>${message}</span>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        // Event Listeners & Initialization
        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Menu Toggle
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Tutup mobile menu saat link diklik
            mobileMenu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
            });

            // Inisialisasi Tab Daftar Harga (Default: Main di Tempat Rental)
            switchPriceTab('onsite');

            // Inisialisasi Form Kalkulator
            updateDurationOptions();
            calculateTotal();

            // Event Listener Perubahan Form untuk Kalkulasi Otomatis
            document.getElementById('console-type').addEventListener('change', () => {
                updateDurationOptions();
                calculateTotal();
            });

            document.getElementById('service-type').addEventListener('change', () => {
                updateDurationOptions();
                calculateTotal();
            });

            ['duration-type', 'extra-stick', 'delivery-zone', 'payment-method'].forEach(id => {
                document.getElementById(id).addEventListener('change', calculateTotal);
            });
        });
    </script>
</body>
</html>
