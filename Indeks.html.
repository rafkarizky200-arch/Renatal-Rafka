<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rizz Store - Rental PlayStation PS3, PS4 & PS5 Terbaik</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Orbitron -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Orbitron:wght@600;700;800;900&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        gaming: ['Orbitron', 'sans-serif'],
                    },
                    colors: {
                        psBlue: '#0070D1',
                        psDarkBlue: '#00439C',
                        neonPurple: '#8B5CF6',
                        darkBg: '#090D16',
                        cardBg: '#111827',
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Scrollbar & Subtle Effects */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090D16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1E293B;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #0070D1;
        }
        .glow-blue {
            box-shadow: 0 0 25px rgba(0, 112, 209, 0.35);
        }
        .glow-purple {
            box-shadow: 0 0 25px rgba(139, 92, 246, 0.3);
        }
        .bg-grid-pattern {
            background-image: radial-gradient(rgba(0, 112, 209, 0.15) 1px, transparent 1px);
            background-size: 28px 28px;
        }
    </style>
</head>
<body class="bg-darkBg text-slate-100 font-sans antialiased selection:bg-psBlue selection:text-white">

    <!-- Toast Notification Container (Pengganti alert) -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- Navbar / Header -->
    <header class="sticky top-0 z-40 bg-darkBg/85 backdrop-blur-md border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                <!-- Brand Logo -->
                <a href="#" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-psBlue to-neonPurple flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform">
                        <i class="fa-brands fa-playstation text-white text-xl sm:text-2xl"></i>
                    </div>
                    <div>
                        <span class="font-gaming font-extrabold text-xl sm:text-2xl tracking-wider bg-gradient-to-r from-white via-blue-200 to-purple-300 bg-clip-text text-transparent">
                            RIZZ STORE
                        </span>
                        <span class="block text-[10px] sm:text-xs text-blue-400 font-medium tracking-widest uppercase -mt-1">
                            PlayStation Rental
                        </span>
                    </div>
                </a>

                <!-- Desktop Navigation -->
                <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                    <a href="#keunggulan" class="hover:text-psBlue transition-colors">Layanan</a>
                    <a href="#harga" class="hover:text-psBlue transition-colors">Daftar Harga</a>
                    <a href="#order" class="hover:text-psBlue transition-colors">Booking & Kalkulator</a>
                    <a href="#pembayaran" class="hover:text-psBlue transition-colors">Pembayaran & S&K</a>
                </nav>

                <!-- CTA Button -->
                <div class="flex items-center gap-3">
                    <a href="#order" class="hidden sm:inline-flex items-center gap-2 bg-psBlue hover:bg-blue-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all shadow-lg shadow-blue-600/25">
                        <i class="fa-solid fa-gamepad"></i>
                        <span>Sewa Sekarang</span>
                    </a>
                    <!-- Mobile Menu Button -->
                    <button id="mobile-menu-btn" aria-label="Buka Menu" class="md:hidden p-2.5 rounded-xl bg-slate-800/80 text-slate-200 hover:bg-slate-700">
                        <i class="fa-solid fa-bars text-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden bg-cardBg border-b border-slate-800 px-4 pt-2 pb-5 space-y-2">
            <a href="#keunggulan" class="block px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white font-medium">Layanan Kami</a>
            <a href="#harga" class="block px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white font-medium">Daftar Harga</a>
            <a href="#order" class="block px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white font-medium">Booking & Kalkulator</a>
            <a href="#pembayaran" class="block px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white font-medium">Pembayaran & S&K</a>
            <a href="#order" class="block text-center mt-3 bg-gradient-to-r from-psBlue to-neonPurple text-white font-semibold py-3 rounded-xl">
                Pesan Sekarang via WA
            </a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-grid-pattern pt-12 pb-20 sm:pt-20 sm:pb-28 border-b border-slate-800/80">
        <!-- Decorative Ambient Glows -->
        <div class="absolute top-10 left-1/4 w-72 h-72 bg-psBlue/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-10 right-1/4 w-80 h-80 bg-neonPurple/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <!-- Left Content -->
                <div class="lg:col-span-7 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs sm:text-sm font-semibold mb-6">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Buka Setiap Hari • Unit Terawat & Game Terbaru!</span>
                    </div>
                    
                    <h1 class="font-gaming text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight mb-6">
                        Mabar Tanpa Batas Bareng <span class="bg-gradient-to-r from-psBlue via-blue-400 to-neonPurple bg-clip-text text-transparent">Rizz Store</span>
                    </h1>
                    
                    <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed">
                        Sewa <strong>PS3, PS4 Pro/Slim, hingga PS5</strong> dengan mudah! Bisa main santai di tempat rental kami yang nyaman, ambil sendiri (COD), atau <strong>kami antar langsung sampai depan pintu rumahmu</strong>.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                        <a href="#order" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-psBlue to-blue-600 hover:from-blue-600 hover:to-blue-500 text-white font-bold px-7 py-4 rounded-2xl transition-all glow-blue text-base">
                            <i class="fa-brands fa-whatsapp text-xl"></i>
                            <span>Order via WhatsApp</span>
                        </a>
                        <a href="#harga" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-800/90 hover:bg-slate-800 border border-slate-700 text-slate-200 font-semibold px-7 py-4 rounded-2xl transition-all text-base">
                            <i class="fa-solid fa-tags text-psBlue"></i>
                            <span>Lihat Daftar Harga</span>
                        </a>
                    </div>

                    <!-- Quick Stats -->
                    <div class="grid grid-cols-3 gap-4 mt-10 pt-8 border-t border-slate-800/80 max-w-lg mx-auto lg:mx-0">
                        <div>
                            <p class="font-gaming text-xl sm:text-2xl font-bold text-white">PS3-PS5</p>
                            <p class="text-xs sm:text-sm text-slate-400">Konsol Lengkap</p>
                        </div>
                        <div>
                            <p class="font-gaming text-xl sm:text-2xl font-bold text-psBlue">4K HDR</p>
                            <p class="text-xs sm:text-sm text-slate-400">TV & Monitor Gaming</p>
                        </div>
                        <div>
                            <p class="font-gaming text-xl sm:text-2xl font-bold text-neonPurple">24 Jam</p>
                            <p class="text-xs sm:text-sm text-slate-400">Paket Harian & Antar</p>
                        </div>
                    </div>
                </div>

                <!-- Right Hero Visual Card -->
                <div class="lg:col-span-5">
                    <div class="relative bg-gradient-to-b from-slate-800/90 to-cardBg p-6 sm:p-8 rounded-3xl border border-slate-700/80 shadow-2xl glow-purple">
                        <div class="flex items-center justify-between mb-6">
                            <span class="px-3 py-1 rounded-lg bg-purple-500/20 text-purple-300 text-xs font-bold uppercase tracking-wider">
                                Pilihan Favorit
                            </span>
                            <div class="flex gap-1.5 text-slate-400 text-sm">
                                <i class="fa-solid fa-play text-psBlue"></i>
                                <i class="fa-regular fa-circle text-red-400"></i>
                                <i class="fa-solid fa-xmark text-blue-400"></i>
                                <i class="fa-regular fa-square text-pink-400"></i>
                            </div>
                        </div>

                        <!-- Console Highlight Illustration -->
                        <div class="bg-darkBg/90 rounded-2xl p-6 border border-slate-800 text-center mb-6">
                            <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-tr from-psBlue/20 to-neonPurple/20 border border-blue-500/30 flex items-center justify-center mb-4">
                                <i class="fa-solid fa-gamepad text-4xl text-blue-400"></i>
                            </div>
                            <h3 class="font-gaming text-xl font-bold text-white mb-1">Paket Mabar Anti Ribet</h3>
                            <p class="text-sm text-slate-400">Include 2 Stick Original + Kabel HDMI & Power + Ratusan Game Hits</p>
                        </div>

                        <!-- Service Modes Mini List -->
                        <div class="space-y-3 text-sm">
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 border border-slate-700/50">
                                <span class="flex items-center gap-2.5 text-slate-200 font-medium">
                                    <i class="fa-solid fa-store text-psBlue"></i> Main di Tempat Rental
                                </span>
                                <span class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-lg">Mulai Rp 5.000/jam</span>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 border border-slate-700/50">
                                <span class="flex items-center gap-2.5 text-slate-200 font-medium">
                                    <i class="fa-solid fa-box-open text-purple-400"></i> Ambil Sendiri / COD
                                </span>
                                <span class="text-xs font-semibold text-blue-300 bg-blue-500/10 px-2.5 py-1 rounded-lg">Mulai Rp 30.000</span>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-800/60 border border-slate-700/50">
                                <span class="flex items-center gap-2.5 text-slate-200 font-medium">
                                    <i class="fa-solid fa-motorcycle text-amber-400"></i> Diantar Sampai Rumah
                                </span>
                                <span class="text-xs font-semibold text-amber-300 bg-amber-500/10 px-2.5 py-1 rounded-lg">Terima Beres!</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3 Bentuk Pemesanan / Layanan -->
    <section id="keunggulan" class="py-16 sm:py-20 bg-darkBg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-psBlue font-gaming text-xs sm:text-sm font-bold tracking-widest uppercase">Fleksibel & Praktis</span>
                <h2 class="font-gaming text-2xl sm:text-4xl font-bold text-white mt-2 mb-4">3 Pilihan Cara Sewa di Rizz Store</h2>
                <p class="text-slate-400 text-sm sm:text-base">Sesuaikan pengalaman gaming-mu dengan cara pemesanan yang paling nyaman buat kamu dan teman-teman.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
                <!-- Card 1 -->
                <div class="bg-cardBg p-6 sm:p-8 rounded-3xl border border-slate-800 hover:border-psBlue/60 transition-all group">
                    <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-psBlue text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-couch"></i>
                    </div>
                    <h3 class="font-gaming text-xl font-bold text-white mb-3">1. Main di Tempat Rental</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-4">
                        Datang langsung ke basecamp Rizz Store. Tempat adem, sofa nyaman, layar besar, bisa sewa per jam maupun paket begadang hemat.
                    </p>
                    <span class="inline-block text-xs font-semibold text-blue-400 bg-blue-500/10 px-3 py-1.5 rounded-xl">
                        Tanpa Jaminan KTP • Langsung Main
                    </span>
                </div>

                <!-- Card 2 -->
                <div class="bg-cardBg p-6 sm:p-8 rounded-3xl border border-slate-800 hover:border-neonPurple/60 transition-all group">
                    <div class="w-14 h-14 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-neonPurple text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-handshake"></i>
                    </div>
                    <h3 class="font-gaming text-xl font-bold text-white mb-3">2. Ambil Sendiri / COD</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-4">
                        Booking via WhatsApp agar unit disiapkan, lalu ambil unit langsung di lokasi Rizz Store atau titik COD terdekat tanpa biaya ongkir.
                    </p>
                    <span class="inline-block text-xs font-semibold text-purple-400 bg-purple-500/10 px-3 py-1.5 rounded-xl">
                        Bebas Ongkir • Paket 6 Jam - 3 Hari
                    </span>
                </div>

                <!-- Card 3 -->
                <div class="bg-cardBg p-6 sm:p-8 rounded-3xl border border-slate-800 hover:border-amber-500/60 transition-all group">
                    <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <h3 class="font-gaming text-xl font-bold text-white mb-3">3. Diantar Sampai Rumah</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-4">
                        Mager keluar rumah? Tim Rizz Store siap mengantar dan membantu instalasi konsol langsung ke TV/Monitor di rumahmu!
                    </p>
                    <span class="inline-block text-xs font-semibold text-amber-400 bg-amber-500/10 px-3 py-1.5 rounded-xl">
                        Free Ongkir Area Dekat (&lt;3 km)
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Price List Section -->
    <section id="harga" class="py-16 sm:py-24 bg-slate-900/40 border-y border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="text-neonPurple font-gaming text-xs sm:text-sm font-bold tracking-widest uppercase">Transparan & Terjangkau</span>
                <h2 class="font-gaming text-2xl sm:text-4xl font-bold text-white mt-2 mb-4">Daftar Harga Sewa Rizz Store</h2>
                <p class="text-slate-400 text-sm sm:text-base">
                    Pilih tipe layanan di bawah ini untuk melihat perbandingan harga <strong>PS3, PS4 Pro/Slim, dan PS5</strong> berdasarkan durasi waktu.
                </p>
            </div>

            <!-- Interactive Filter Tabs: Bentuk Pemesanan -->
            <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10" role="tablist">
                <button onclick="switchPriceTab('onsite')" id="tab-onsite" class="price-tab active-tab px-4 sm:px-6 py-3 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 bg-psBlue text-white shadow-lg shadow-blue-600/30">
                    <i class="fa-solid fa-store"></i>
                    <span>Main di Tempat Rental</span>
                </button>
                <button onclick="switchPriceTab('cod')" id="tab-cod" class="price-tab px-4 sm:px-6 py-3 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 bg-cardBg text-slate-300 hover:bg-slate-800 border border-slate-700">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Ambil Sendiri / COD</span>
                </button>
                <button onclick="switchPriceTab('delivery')" id="tab-delivery" class="price-tab px-4 sm:px-6 py-3 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 bg-cardBg text-slate-300 hover:bg-slate-800 border border-slate-700">
                    <i class="fa-solid fa-motorcycle"></i>
                    <span>Diantar Sampai Rumah</span>
                </button>
            </div>

            <!-- Dynamic Info Banner for Selected Tab -->
            <div id="tab-info-banner" class="max-w-3xl mx-auto mb-10 p-4 rounded-2xl bg-blue-500/10 border border-blue-500/30 text-center text-xs sm:text-sm text-blue-200">
                <i class="fa-solid fa-circle-info text-psBlue mr-1.5"></i>
                <span id="tab-info-text">Harga <strong>Main di Tempat Rental</strong> sudah termasuk TV LED/4K, 2 Stick, dan tempat nyaman ber-AC. Tersedia tarif per jam!</span>
            </div>

            <!-- Console Pricing Cards Grid (PS3, PS4, PS5) -->
            <div id="pricing-cards-container" class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Cards will be dynamically rendered by JS -->
            </div>

            <!-- Add-on Info -->
            <div class="mt-10 bg-cardBg/80 border border-slate-800 rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-purple-500/15 text-purple-400 flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-plus"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-white text-sm sm:text-base">Butuh Tambahan Stick (Controller) untuk Mabar 4 Orang?</h4>
                        <p class="text-xs sm:text-sm text-slate-400">Sewa Stick Extra: <strong>PS3</strong> (+Rp 5.000/paket) • <strong>PS4</strong> (+Rp 10.000/paket) • <strong>PS5 DualSense</strong> (+Rp 20.000/paket)</p>
                    </div>
                </div>
                <a href="#order" class="shrink-0 text-xs sm:text-sm font-bold text-psBlue hover:text-blue-400 flex items-center gap-1.5">
                    <span>Hitung di Kalkulator</span>
                    <i class="fa-solid fa-arrow-down"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Booking Form & Real-Time Price Calculator -->
    <section id="order" class="py-16 sm:py-24 bg-darkBg relative">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-psBlue font-gaming text-xs sm:text-sm font-bold tracking-widest uppercase">Booking Instan</span>
                <h2 class="font-gaming text-2xl sm:text-4xl font-bold text-white mt-2 mb-4">Form Pemesanan & Kalkulator Sewa</h2>
                <p class="text-slate-400 text-sm sm:text-base">Isi detail pesananmu di bawah ini. Total biaya dihitung otomatis dan langsung terkirim rapi ke WhatsApp admin Rizz Store.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Left: Form Input -->
                <form id="rental-form" class="lg:col-span-7 bg-cardBg p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-xl space-y-5">
                    <!-- Nama Pemesan -->
                    <div>
                        <label for="customer-name" class="block text-sm font-semibold text-slate-200 mb-2">
                            Nama Pemesan <span class="text-red-400">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <input type="text" id="customer-name" required placeholder="Contoh: Raka Pratama" 
                                class="w-full pl-10 pr-4 py-3 rounded-xl bg-darkBg border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-psBlue focus:ring-1 focus:ring-psBlue transition-all text-sm sm:text-base">
                        </div>
                    </div>

                    <!-- Grid: Tipe PS & Bentuk Pemesanan -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label for="console-type" class="block text-sm font-semibold text-slate-200 mb-2">
                                Pilih Tipe PlayStation
                            </label>
                            <select id="console-type" class="w-full px-4 py-3 rounded-xl bg-darkBg border border-slate-700 text-white focus:outline-none focus:border-psBlue text-sm sm:text-base">
                                <option value="ps3">PlayStation 3 (PS3 Slim/Super Slim)</option>
                                <option value="ps4" selected>PlayStation 4 (PS4 Slim / Pro)</option>
                                <option value="ps5">PlayStation 5 (PS5 Disc / Digital)</option>
                            </select>
                        </div>

                        <div>
                            <label for="service-type" class="block text-sm font-semibold text-slate-200 mb-2">
                                Bentuk Pemesanan
                            </label>
                            <select id="service-type" class="w-full px-4 py-3 rounded-xl bg-darkBg border border-slate-700 text-white focus:outline-none focus:border-psBlue text-sm sm:text-base">
                                <option value="onsite">Main di Tempat Rental</option>
                                <option value="cod" selected>Ambil Sendiri / COD</option>
                                <option value="delivery">Diantar Sampai Rumah</option>
                            </select>
                        </div>
                    </div>

                    <!-- Grid: Durasi Sewa & Tambahan Stick -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label for="duration-type" class="block text-sm font-semibold text-slate-200 mb-2">
                                Durasi Sewa
                            </label>
                            <select id="duration-type" class="w-full px-4 py-3 rounded-xl bg-darkBg border border-slate-700 text-white focus:outline-none focus:border-psBlue text-sm sm:text-base">
                                <!-- Options populated dynamically based on service-type -->
                            </select>
                        </div>

